<Window x:Class="SSC.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Shadow Server Command — Minecraft Edition v0.1.0 Alpha" Width="1360" Height="900" MinWidth="950" MinHeight="700" PreviewKeyDown="OnPreviewKeyDown">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderThickness="1" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="S H A D O W   S E R V E R   C O M M A N D" FontSize="25" FontWeight="Bold"/><TextBlock Text="SSC-MC // MINECRAFT EDITION // v0.1.0 ALPHA" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="[ SIMULATED DASHBOARD ]" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="WATCHDOG: LOCAL AM5 STATUS" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderThickness="1" Padding="8" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="[ OPERATIONS INDEX ]" Margin="6,5,0,12"/><ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedModule}" DisplayMemberPath="Label" AutomationProperties.Name="Operations navigation"/></DockPanel></Border>
   <Border Grid.Column="1" BorderThickness="1" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding SelectedModule.Definition.Title}" FontSize="22" FontWeight="Bold"/>
    <TextBlock Text="{Binding SelectedModule.Definition.Description}" Margin="0,8,0,16" Foreground="{StaticResource MutedBrush}"/>
    <TextBlock Text="[ WATCHDOG / LIVE LOCAL SERVICE STATUS ]" Margin="0,0,0,12">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsWatchdog}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding WatchdogDegraded}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding WatchdogCritical}" Value="True"><Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,14"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding ShowMetrics}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderThickness="1" Margin="0,0,8,8" Padding="10"><StackPanel><TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Display}" FontSize="16" Margin="0,6,0,0"/><TextBlock Text="SIMULATED SOURCE" Foreground="{StaticResource WarningBrush}" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="FILTER CURRENT MODULE / LOG SEARCH" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" AutomationProperties.Name="Filter current module"/>
    <Border BorderThickness="0,0,0,1" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Column1}"/><TextBlock Grid.Column="1" Text="{Binding Column2}"/><TextBlock Grid.Column="2" Text="{Binding Column3}"/></Grid></Border>
    <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderThickness="0,0,0,1" Padding="8,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding [0]}" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding [1]}" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0"/><TextBlock Grid.Column="2" Text="{Binding [2]}" Foreground="{StaticResource MutedBrush}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="{Binding HistorySummary}" Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="2" BorderThickness="1" Padding="12" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="[ LOCAL COMMAND TERMINAL ]  F1 help / Ctrl+L focus / Ctrl+W watchdog / F5 refresh" Foreground="{StaticResource MutedBrush}"/><TextBox Grid.Row="1" Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" TextWrapping="Wrap" AutomationProperties.Name="Terminal output"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SSC&gt; " VerticalAlignment="Center"/><TextBox x:Name="CommandInput" Grid.Column="1" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnCommandKeyDown" AutomationProperties.Name="Local command input"/><TextBlock Grid.Column="2" Text=" ▌" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.7" AutoReverse="True"/></Storyboard></BeginStoryboard></EventTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid></Border>
  <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" Foreground="{StaticResource WarningBrush}"/>
  <Rectangle Grid.RowSpan="4" IsHitTestVisible="False" Opacity="0.11"><Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CrtEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Rectangle.Style><Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="#66FF66" Geometry="M0,0 L4,0 4,1 0,1Z"/></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill></Rectangle>
 </Grid>
</Window>
